@using Microsoft.AspNetCore.Identity
@inject UserManager<VehicleParkingManagementSystem.Models.ApplicationUser> LayoutUserManager
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - VehicleParkingManagementSystem</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/VehicleParkingManagementSystem.styles.css" asp-append-version="true" />
    <script>
        (function () {
            var saved = localStorage.getItem('vpms-theme');
            var theme = saved === 'dark' ? 'dark' : 'light';
            document.documentElement.setAttribute('data-bs-theme', theme);
        })();
    </script>
</head>
<body>
    @{
        var isAdmin = User.IsInRole(VehicleParkingManagementSystem.Models.AppRoles.Admin);
        var isOfficer = User.IsInRole(VehicleParkingManagementSystem.Models.AppRoles.ParkingOfficer);
        var isStaff = isAdmin || isOfficer;
        var isAuthenticated = User.Identity?.IsAuthenticated == true;
        var roleLabel = isAdmin ? "Administrator" : isOfficer ? "Parking Officer" : "Driver";
        var dashboardController = isAdmin ? "Admin" : isOfficer ? "Officer" : "Driver";
        string? profilePicturePath = isAuthenticated ? (await LayoutUserManager.GetUserAsync(User))?.ProfilePicturePath : null;
    }

    @if (isAuthenticated)
    {
        <div class="app-backdrop" id="appBackdrop"></div>
        <aside class="app-sidebar" id="appSidebar">
            <div class="brand">
                <div class="brand-icon"><i class="bi bi-p-square-fill"></i></div>
                <div>
                    <div class="brand-title">Parking Pro</div>
                    <div class="brand-subtitle">Smart Parking Solutions</div>
                </div>
            </div>
            <nav class="nav flex-column app-sidebar-nav">
                <a class="nav-link" asp-controller="@dashboardController" asp-action="Index"><i class="bi bi-speedometer2"></i> Dashboard</a>

                @if (isStaff)
                {
                    <a class="nav-link" asp-controller="ParkingAreas" asp-action="Index"><i class="bi bi-geo-alt"></i> Parking Areas</a>
                    <a class="nav-link" asp-controller="Vehicles" asp-action="Index"><i class="bi bi-car-front"></i> Vehicles</a>
                    <a class="nav-link" asp-controller="Drivers" asp-action="Index"><i class="bi bi-people"></i> Drivers</a>
                }

                <a class="nav-link" asp-controller="Reservations" asp-action="Index"><i class="bi bi-calendar-check"></i> Reservations</a>

                @if (isStaff)
                {
                    <a class="nav-link" asp-controller="ParkingOperations" asp-action="Index"><i class="bi bi-arrow-left-right"></i> Transactions</a>
                    <a class="nav-link" asp-controller="Reports" asp-action="Index"><i class="bi bi-file-earmark-bar-graph"></i> Reports</a>
                }

                <a class="nav-link" asp-controller="Notifications" asp-action="Index"><i class="bi bi-bell"></i> Notifications</a>

                @if (isAdmin)
                {
                    <a class="nav-link" asp-controller="Users" asp-action="Index"><i class="bi bi-person-badge"></i> Users</a>
                    <a class="nav-link" asp-controller="AuditLogs" asp-action="Index"><i class="bi bi-clock-history"></i> Audit Logs</a>
                    <a class="nav-link" asp-controller="Settings" asp-action="Index"><i class="bi bi-gear"></i> Settings</a>
                }
            </nav>
            <div class="app-sidebar-footer">
                <button class="nav-link border-0 bg-transparent w-100 text-start d-lg-none" id="sidebarCollapseBtn" type="button">
                    <i class="bi bi-arrow-bar-left"></i> Collapse
                </button>
            </div>
        </aside>
    }

    <div class="app-main">
        <header class="app-topbar d-flex align-items-center px-3">
            @if (isAuthenticated)
            {
                <button class="btn btn-sm btn-outline-secondary d-lg-none me-2" id="sidebarToggle" type="button">
                    <i class="bi bi-list"></i>
                </button>
                <div>
                    <div class="page-title">@(ViewBag.PageTitle ?? ViewData["Title"])</div>
                    <div class="page-subtitle">@(ViewBag.PageSubtitle ?? $"Welcome back, {User.Identity!.Name}")</div>
                </div>
            }
            <div class="ms-auto d-flex align-items-center gap-2">
                @if (isAuthenticated)
                {
                    @if (isStaff)
                    {
                        <form asp-controller="Vehicles" asp-action="Index" method="get" class="topbar-search d-none d-md-flex align-items-center me-2">
                            <i class="bi bi-search text-muted"></i>
                            <input type="text" name="search" placeholder="Search vehicles..." />
                        </form>
                    }
                    <button type="button" class="icon-btn theme-toggle-btn" id="themeToggleBtn" title="Toggle dark mode" aria-label="Toggle dark mode">
                        <i class="bi bi-moon-stars theme-icon-dark"></i>
                        <i class="bi bi-sun-fill theme-icon-light"></i>
                    </button>
                    @await Component.InvokeAsync("Notifications")
                    <div class="dropdown">
                        <a class="d-flex align-items-center gap-2 text-decoration-none dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            @if (!string.IsNullOrEmpty(profilePicturePath))
                            {
                                <img src="@profilePicturePath" alt="Profile" class="rounded-circle" style="width: 38px; height: 38px; object-fit: cover;" />
                            }
                            else
                            {
                                <span class="avatar-circle">@User.Identity!.Name!.Substring(0, 1).ToUpper()</span>
                            }
                            <span class="d-none d-md-block text-start">
                                <span class="d-block fw-semibold text-dark small">@User.Identity!.Name</span>
                                <span class="d-block text-muted" style="font-size: 0.72rem;">@roleLabel</span>
                            </span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" asp-controller="Account" asp-action="Profile"><i class="bi bi-person-circle me-1"></i> My Profile</a></li>
                            <li><a class="dropdown-item" asp-controller="Account" asp-action="ChangePassword">Change Password</a></li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit" class="dropdown-item">Logout</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                }
                else
                {
                    <a class="btn btn-sm btn-outline-primary me-2" asp-controller="Account" asp-action="Login">Login</a>
                    <a class="btn btn-sm btn-primary" asp-controller="Account" asp-action="Register">Register</a>
                }
            </div>
        </header>

        <main role="main" class="app-content">
            @RenderBody()
        </main>

        <footer class="border-top text-muted py-3 px-4">
            <small>&copy; 2026 - VehicleParkingManagementSystem - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a></small>
        </footer>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        (function () {
            const sidebar = document.getElementById('appSidebar');
            const backdrop = document.getElementById('appBackdrop');
            const toggle = document.getElementById('sidebarToggle');
            const collapseBtn = document.getElementById('sidebarCollapseBtn');

            function closeSidebar() {
                sidebar?.classList.remove('show');
                backdrop?.classList.remove('show');
            }

            toggle?.addEventListener('click', function () {
                sidebar?.classList.toggle('show');
                backdrop?.classList.toggle('show');
            });

            collapseBtn?.addEventListener('click', closeSidebar);
            backdrop?.addEventListener('click', closeSidebar);

            document.querySelectorAll('.app-sidebar .nav-link').forEach(function (link) {
                if (link.href === window.location.href) {
                    link.classList.add('active');
                }
            });

            var themeToggleBtn = document.getElementById('themeToggleBtn');
            themeToggleBtn?.addEventListener('click', function () {
                var current = document.documentElement.getAttribute('data-bs-theme');
                var next = current === 'dark' ? 'light' : 'dark';
                document.documentElement.setAttribute('data-bs-theme', next);
                localStorage.setItem('vpms-theme', next);
            });
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
