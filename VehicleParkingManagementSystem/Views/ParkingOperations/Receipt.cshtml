@model VehicleParkingManagementSystem.Models.ParkingRecord
@{
    ViewData["Title"] = "Receipt";
}

<style>
    @@media print {
        header, footer, .no-print { display: none !important; }
        .receipt-card { box-shadow: none !important; border: 1px solid #ccc !important; }
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-3 no-print">
    <h3 class="mb-0">Parking Receipt</h3>
    <div>
        <button onclick="window.print()" class="btn btn-primary"><i class="bi bi-printer"></i> Print</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Back to Operations</a>
    </div>
</div>

<div class="app-card receipt-card" style="max-width: 480px;">
    <div class="card-body">
        <div class="text-center mb-3">
            <i class="bi bi-p-square-fill text-primary" style="font-size: 2rem;"></i>
            <h5 class="mb-0">Vehicle Parking Management</h5>
            <p class="text-muted small mb-0">Official Parking Receipt</p>
        </div>
        <hr />
        <dl class="row mb-0 small">
            <dt class="col-6">Receipt No.</dt>
            <dd class="col-6 text-end">PK-@Model.Id.ToString("D6")</dd>

            <dt class="col-6">Vehicle Number</dt>
            <dd class="col-6 text-end">@Model.Vehicle?.VehicleNumber</dd>

            <dt class="col-6">Owner</dt>
            <dd class="col-6 text-end">@Model.Vehicle?.OwnerName</dd>

            <dt class="col-6">Parking Area</dt>
            <dd class="col-6 text-end">@(Model.ParkingArea?.Name ?? "-")</dd>

            <dt class="col-6">Check-In</dt>
            <dd class="col-6 text-end">@Model.CheckInTime.ToLocalTime().ToString("d MMM yyyy, HH:mm")</dd>

            <dt class="col-6">Check-Out</dt>
            <dd class="col-6 text-end">@Model.CheckOutTime?.ToLocalTime().ToString("d MMM yyyy, HH:mm")</dd>

            <dt class="col-6">Duration</dt>
            <dd class="col-6 text-end">@(Model.Duration.HasValue ? $"{(int)Model.Duration.Value.TotalHours}h {Model.Duration.Value.Minutes}m" : "-")</dd>

            @if (Model.ParkingPackage is not null)
            {
                <dt class="col-6">Package</dt>
                <dd class="col-6 text-end">@Model.ParkingPackage.Name (prepaid)</dd>
            }
            else if (Model.AutoCheckedOut)
            {
                <dt class="col-6">Checkout</dt>
                <dd class="col-6 text-end">Automatic (time expired)</dd>
            }
        </dl>
        <hr />
        <div class="d-flex justify-content-between fs-5 fw-bold">
            <span>Total Paid</span>
            <span>@Model.Fee?.ToString("C")</span>
        </div>
        <p class="text-center text-muted small mt-3 mb-0">Thank you for parking with us.</p>
    </div>
</div>
