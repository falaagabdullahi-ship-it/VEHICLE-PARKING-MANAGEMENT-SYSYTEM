@model VehicleParkingManagementSystem.Models.ViewModels.PagedResult<VehicleParkingManagementSystem.Models.ViewModels.ParkingOperations.ExitedVehicleItem>
@{
    ViewData["Title"] = "Vehicles Exited";
    ViewBag.PageTitle = "Vehicles";
    ViewBag.PageSubtitle = $"All check-outs and deleted vehicles on {DateTime.Parse((string)ViewBag.Date):d MMM yyyy}";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Vehicles Exited on @DateTime.Parse((string)ViewBag.Date).ToString("d MMM yyyy")</h3>
    <div class="d-flex gap-2">
        <a asp-action="HistoryExportExcel" asp-route-date="@ViewBag.Date" asp-route-search="@ViewBag.Search" asp-route-mode="exited" class="btn btn-outline-success btn-sm"><i class="bi bi-file-earmark-excel"></i> Export to Excel</a>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i> Back to Transactions</a>
    </div>
</div>

<form method="get" asp-action="History" class="row g-2 mb-3">
    <input type="hidden" name="mode" value="exited" />
    <div class="col-md-3">
        <input type="date" name="date" value="@ViewBag.Date" class="form-control" />
    </div>
    <div class="col-md-4">
        <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Search by vehicle number or owner..." />
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-outline-secondary w-100"><i class="bi bi-filter"></i> Filter</button>
    </div>
</form>

<div class="app-card">
    <div class="table-responsive">
        <table class="table table-modern table-hover mb-0 align-middle">
            <thead>
                <tr>
                    <th>Vehicle</th>
                    <th>Owner</th>
                    <th>Area</th>
                    <th>Check-In</th>
                    <th>Check-Out / Deleted</th>
                    <th>Fee</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    var isDeleted = item.Status == "Deleted";
                    <tr>
                        <td class="fw-semibold">@item.VehicleNumber</td>
                        <td>@item.OwnerName</td>
                        <td>@(item.AreaName ?? "-")</td>
                        <td>@(item.CheckInTime?.ToLocalTime().ToString("d MMM, HH:mm") ?? "-")</td>
                        <td>@item.EventTime.ToLocalTime().ToString("d MMM, HH:mm")</td>
                        <td>@(item.Fee?.ToString("C") ?? "-")</td>
                        <td>
                            @if (isDeleted)
                            {
                                <span class="status-pill" style="background:rgba(248,113,113,0.15); color:#dc2626;">Deleted</span>
                            }
                            else
                            {
                                <span class="status-pill completed">Completed</span>
                            }
                        </td>
                        <td class="text-end">
                            @if (item.ParkingRecordId is not null)
                            {
                                <a asp-action="Receipt" asp-route-id="@item.ParkingRecordId" class="btn btn-sm btn-outline-secondary"><i class="bi bi-receipt"></i> Receipt</a>
                            }
                            else
                            {
                                <span class="text-muted small">&ndash;</span>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Items.Any())
                {
                    <tr><td colspan="8" class="text-center text-muted py-4">No vehicles checked out or deleted on this date.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination justify-content-center">
            @for (var i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                    <a class="page-link" asp-action="History" asp-route-page="@i" asp-route-date="@ViewBag.Date" asp-route-search="@ViewBag.Search" asp-route-mode="exited">@i</a>
                </li>
            }
        </ul>
    </nav>
}
