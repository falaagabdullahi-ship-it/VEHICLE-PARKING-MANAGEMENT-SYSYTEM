@model VehicleParkingManagementSystem.Models.ViewModels.PagedResult<VehicleParkingManagementSystem.Models.ParkingRecord>
@{
    ViewData["Title"] = "Parking Operations";
    var checkIn = (VehicleParkingManagementSystem.Models.ViewModels.ParkingOperations.CheckInViewModel)ViewBag.CheckIn;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Parking Operations</h3>
    <div class="d-flex gap-2">
        <a asp-action="AddTransaction" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Add Transaction</a>
        <a asp-action="ExportExcel" asp-route-search="@ViewBag.Search" class="btn btn-outline-success"><i class="bi bi-file-earmark-excel"></i> Export to Excel</a>
    </div>
</div>

@if (TempData["StatusMessage"] is not null)
{
    <div class="alert alert-info">@TempData["StatusMessage"]</div>
}

<div class="app-card mb-4">
    <div class="card-body">
        <h5 class="card-title">Check In Vehicle</h5>
        <div class="text-muted small mb-2">A parking package must be selected (unless the vehicle has an active reservation) — the fee is charged now and the vehicle is checked out automatically once its time is up.</div>
        <form asp-action="CheckIn" method="post" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label">Vehicle Number</label>
                <input type="text" name="VehicleNumber" class="form-control" placeholder="e.g. KDA 123X" required autofocus />
            </div>
            <div class="col-md-2">
                <label class="form-label">Parking Area (optional)</label>
                <select id="checkInArea" name="ParkingAreaId" asp-items="checkIn.AreaOptions" class="form-select">
                    <option value="">-- Any Area (auto) --</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Vehicle Type</label>
                <select id="checkInVehicleType" class="form-select">
                    @foreach (var type in Enum.GetValues<VehicleParkingManagementSystem.Models.VehicleType>())
                    {
                        <option value="@type">@type</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Package</label>
                <select id="checkInPackage" name="ParkingPackageId" class="form-select" required>
                    <option value="">-- Select Package --</option>
                    @foreach (var package in checkIn.PackageOptions)
                    {
                        <option value="@package.Id" data-type="@package.VehicleType" data-area="@package.ParkingAreaId">@package.Name — @(package.DurationMinutes / 60.0)h — $@package.Price@(package.ParkingArea is null ? "" : " — " + package.ParkingArea.Name)</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100"><i class="bi bi-box-arrow-in-right"></i> Check In</button>
            </div>
        </form>
    </div>
</div>

<script>
    (function () {
        var typeSelect = document.getElementById('checkInVehicleType');
        var areaSelect = document.getElementById('checkInArea');
        var packageSelect = document.getElementById('checkInPackage');
        if (!typeSelect || !packageSelect) return;

        var allOptions = Array.prototype.slice.call(packageSelect.querySelectorAll('option[data-type]'));

        // Show packages for the chosen vehicle type that are valid in any area or in the chosen area.
        // With "Any Area (auto)" selected, area-specific packages are shown too; picking one assigns its area.
        function filterPackages() {
            var selectedType = typeSelect.value;
            var selectedArea = areaSelect ? areaSelect.value : '';
            packageSelect.value = '';
            allOptions.forEach(function (opt) {
                var packageArea = opt.getAttribute('data-area') || '';
                var areaOk = packageArea === '' || selectedArea === '' || packageArea === selectedArea;
                opt.hidden = opt.getAttribute('data-type') !== selectedType || !areaOk;
            });
        }

        typeSelect.addEventListener('change', filterPackages);
        if (areaSelect) areaSelect.addEventListener('change', filterPackages);
        filterPackages();
    })();
</script>

<h5 class="mb-2">Currently Parked Vehicles</h5>
<form method="get" class="row g-2 mb-3">
    <div class="col-auto flex-grow-1">
        <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Search by vehicle number or owner..." />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary"><i class="bi bi-search"></i> Search</button>
    </div>
</form>

<div class="app-card">
    <div class="table-responsive">
        <table class="table table-modern table-hover mb-0 align-middle">
            <thead>
                <tr>
                    <th>Vehicle Number</th>
                    <th>Owner</th>
                    <th>Area</th>
                    <th>Check-In Time</th>
                    <th>Duration So Far</th>
                    <th>Paid Until</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var record in Model.Items)
                {
                    var elapsed = DateTime.UtcNow - record.CheckInTime;
                    <tr>
                        <td class="fw-semibold">@record.Vehicle?.VehicleNumber</td>
                        <td>@record.Vehicle?.OwnerName</td>
                        <td>@(record.ParkingArea?.Name ?? "-")</td>
                        <td>@record.CheckInTime.ToLocalTime().ToString("d MMM, HH:mm")</td>
                        <td>@($"{(int)elapsed.TotalHours}h {elapsed.Minutes}m")</td>
                        <td>@(record.PaidUntil.HasValue ? record.PaidUntil.Value.ToLocalTime().ToString("d MMM, HH:mm") : "-")</td>
                        <td class="text-end">
                            <a asp-action="CheckOut" asp-route-id="@record.Id" class="btn btn-sm btn-outline-danger">
                                <i class="bi bi-box-arrow-right"></i> Check Out
                            </a>
                        </td>
                    </tr>
                }
                @if (!Model.Items.Any())
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">No vehicles currently parked.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination justify-content-center">
            @for (var i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-search="@ViewBag.Search">@i</a>
                </li>
            }
        </ul>
    </nav>
}
