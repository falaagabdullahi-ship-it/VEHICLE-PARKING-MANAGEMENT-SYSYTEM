@model VehicleParkingManagementSystem.Models.ViewModels.ParkingOperations.AddTransactionViewModel
@{
    ViewData["Title"] = "Add Transaction";
}

<h3 class="mb-3">Add Transaction</h3>

<div class="app-card" style="max-width: 600px;">
    <div class="card-body">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>

        <form asp-action="AddTransaction" method="post">
            <div class="mb-3">
                <label asp-for="VehicleNumber" class="form-label"></label>
                <input asp-for="VehicleNumber" class="form-control" placeholder="e.g. KDA 123X" autofocus />
                <span asp-validation-for="VehicleNumber" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ParkingAreaId" class="form-label"></label>
                <select asp-for="ParkingAreaId" asp-items="Model.AreaOptions" class="form-select">
                    <option value="">-- No Area --</option>
                </select>
            </div>

            <div class="mb-3">
                <label asp-for="CheckInTime" class="form-label"></label>
                <input asp-for="CheckInTime" class="form-control" />
                <span asp-validation-for="CheckInTime" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="CheckOutTime" class="form-label"></label>
                <input asp-for="CheckOutTime" class="form-control" />
                <span asp-validation-for="CheckOutTime" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Fee" class="form-label"></label>
                <input asp-for="Fee" class="form-control" step="0.01" />
                <span asp-validation-for="Fee" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-primary">Add Transaction</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </form>
    </div>
</div>
