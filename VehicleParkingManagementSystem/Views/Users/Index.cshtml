@model VehicleParkingManagementSystem.Models.ViewModels.PagedResult<VehicleParkingManagementSystem.Models.ViewModels.Users.StaffUserRow>
@{
    ViewData["Title"] = "User Management";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">User Management</h3>
    <div class="d-flex gap-2">
        <a asp-action="ExportExcel" asp-route-search="@ViewBag.Search" class="btn btn-outline-success"><i class="bi bi-file-earmark-excel"></i> Export to Excel</a>
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> New Staff Account</a>
    </div>
</div>

@if (TempData["StatusMessage"] is not null)
{
    <div class="alert alert-info">@TempData["StatusMessage"]</div>
}

<form method="get" class="row g-2 mb-3">
    <div class="col-auto flex-grow-1">
        <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Search by name or email..." />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary"><i class="bi bi-search"></i> Search</button>
    </div>
</form>

<div class="app-card">
    <div class="table-responsive">
        <table class="table table-modern table-hover mb-0 align-middle">
            <thead>
                <tr><th>Name</th><th>Email</th><th>Phone</th><th>Role(s)</th><th>Status</th><th class="text-end">Actions</th></tr>
            </thead>
            <tbody>
                @foreach (var user in Model.Items)
                {
                    <tr>
                        <td class="fw-semibold">@user.FullName</td>
                        <td>@user.Email</td>
                        <td>@user.PhoneNumber</td>
                        <td>
                            @foreach (var role in user.Roles)
                            {
                                <span class="badge bg-secondary me-1">@role</span>
                            }
                        </td>
                        <td>
                            @if (user.IsLockedOut)
                            {
                                <span class="badge bg-danger">Locked</span>
                            }
                            else
                            {
                                <span class="badge bg-success">Active</span>
                            }
                        </td>
                        <td class="text-end">
                            <form asp-action="ToggleLockout" asp-route-id="@user.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm @(user.IsLockedOut ? "btn-outline-success" : "btn-outline-danger")">
                                    @(user.IsLockedOut ? "Unlock" : "Lock")
                                </button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Items.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">No users found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination justify-content-center">
            @for (var i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-search="@ViewBag.Search">@i</a>
                </li>
            }
        </ul>
    </nav>
}
