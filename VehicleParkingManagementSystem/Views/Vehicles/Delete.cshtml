@model VehicleParkingManagementSystem.Models.Vehicle
@{
    ViewData["Title"] = "Delete Vehicle";
}

<h3 class="mb-3">Delete Vehicle</h3>

<div class="app-card border-danger" style="max-width: 600px;">
    <div class="card-body">
        <p>Are you sure you want to delete the following vehicle?</p>
        <dl class="row mb-0">
            <dt class="col-sm-4">Vehicle Number</dt>
            <dd class="col-sm-8">@Model.VehicleNumber</dd>

            <dt class="col-sm-4">Owner</dt>
            <dd class="col-sm-8">@Model.OwnerName</dd>

            <dt class="col-sm-4">Model</dt>
            <dd class="col-sm-8">@Model.VehicleModel</dd>
        </dl>
    </div>
    <div class="card-footer">
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
            <button type="submit" class="btn btn-danger btn-sm">Delete</button>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Cancel</a>
        </form>
    </div>
</div>
