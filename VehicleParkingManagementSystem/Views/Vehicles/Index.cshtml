@model VehicleParkingManagementSystem.Models.ViewModels.PagedResult<VehicleParkingManagementSystem.Models.Vehicle>
@{
    ViewData["Title"] = "Vehicles";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Vehicles</h3>
    <div class="d-flex gap-2">
        <a asp-action="ExportExcel" asp-route-search="@ViewBag.Search" class="btn btn-outline-success"><i class="bi bi-file-earmark-excel"></i> Export to Excel</a>
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Register Vehicle</a>
    </div>
</div>

@if (TempData["StatusMessage"] is not null)
{
    <div class="alert alert-success">@TempData["StatusMessage"]</div>
}

<form method="get" class="row g-2 mb-3">
    <div class="col-auto flex-grow-1">
        <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Search by vehicle number, owner, model or phone..." />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary"><i class="bi bi-search"></i> Search</button>
    </div>
</form>

<div class="app-card">
    <div class="table-responsive">
        <table class="table table-modern table-hover mb-0 align-middle">
            <thead>
                <tr>
                    <th>Vehicle Number</th>
                    <th>Owner</th>
                    <th>Phone</th>
                    <th>Type</th>
                    <th>Model</th>
                    <th>Color</th>
                    <th>Registered</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var vehicle in Model.Items)
                {
                    <tr>
                        <td class="fw-semibold">@vehicle.VehicleNumber</td>
                        <td>@vehicle.OwnerName</td>
                        <td>@vehicle.PhoneNumber</td>
                        <td>@vehicle.VehicleType</td>
                        <td>@vehicle.VehicleModel</td>
                        <td>@vehicle.Color</td>
                        <td>@vehicle.RegistrationDate.ToString("d MMM yyyy")</td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@vehicle.Id" class="btn btn-sm btn-outline-secondary"><i class="bi bi-eye"></i></a>
                            <a asp-action="Edit" asp-route-id="@vehicle.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></a>
                            <a asp-action="Delete" asp-route-id="@vehicle.Id" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></a>
                        </td>
                    </tr>
                }
                @if (!Model.Items.Any())
                {
                    <tr><td colspan="8" class="text-center text-muted py-4">No vehicles found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination justify-content-center">
            @for (var i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-search="@ViewBag.Search">@i</a>
                </li>
            }
        </ul>
    </nav>
}
