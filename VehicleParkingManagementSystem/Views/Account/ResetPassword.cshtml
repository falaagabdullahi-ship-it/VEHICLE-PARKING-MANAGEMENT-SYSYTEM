@model VehicleParkingManagementSystem.Models.ViewModels.Account.ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset Password";
    Layout = "_AuthLayout";
}

<div class="auth-card">
    <div class="auth-icon"><i class="bi bi-shield-lock-fill"></i></div>
    <h4 class="text-center mb-3">Reset Password</h4>

    <form asp-controller="Account" asp-action="ResetPassword" method="post">
        <input type="hidden" asp-for="Email" />
        <input type="hidden" asp-for="Token" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

        <div class="mb-3">
            <label asp-for="Password" class="form-label"></label>
            <div class="auth-input-group">
                <i class="bi bi-lock"></i>
                <input asp-for="Password" type="password" autofocus />
            </div>
            <span asp-validation-for="Password" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="ConfirmPassword" class="form-label"></label>
            <div class="auth-input-group">
                <i class="bi bi-lock"></i>
                <input asp-for="ConfirmPassword" type="password" />
            </div>
            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
        </div>

        <button type="submit" class="btn btn-auth-primary w-100">Reset Password</button>
    </form>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
