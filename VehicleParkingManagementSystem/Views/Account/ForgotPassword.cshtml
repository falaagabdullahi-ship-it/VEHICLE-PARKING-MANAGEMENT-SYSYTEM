@model VehicleParkingManagementSystem.Models.ViewModels.Account.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
    Layout = "_AuthLayout";
}

<div class="auth-card">
    <div class="auth-icon"><i class="bi bi-key-fill"></i></div>
    <h4 class="text-center mb-1">Forgot Password</h4>
    <p class="text-center text-muted-light small mb-4">Enter your email to receive a reset link</p>

    <form asp-controller="Account" asp-action="ForgotPassword" method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

        <div class="mb-3">
            <label asp-for="Email" class="form-label"></label>
            <div class="auth-input-group">
                <i class="bi bi-envelope"></i>
                <input asp-for="Email" autofocus />
            </div>
            <span asp-validation-for="Email" class="text-danger small"></span>
        </div>

        <button type="submit" class="btn btn-auth-primary w-100">Send Reset Link</button>

        <div class="text-center mt-3 small">
            <a asp-controller="Account" asp-action="Login">Back to sign in</a>
        </div>
    </form>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
