@{
    ViewData["Title"] = "Access Denied";
    Layout = "_AuthLayout";
}

<div class="auth-card text-center">
    <div class="auth-icon" style="background: linear-gradient(135deg, #f87171, #dc2626);"><i class="bi bi-exclamation-octagon-fill"></i></div>
    <h4 class="mb-1">Access Denied</h4>
    <p class="text-muted-light small">You do not have permission to view this page.</p>
    <a asp-controller="Account" asp-action="Login" class="btn btn-auth-primary w-100 mt-2">Back to Sign In</a>
</div>
