@{
    ViewData["Title"] = "Password Reset";
    Layout = "_AuthLayout";
}

<div class="auth-card text-center">
    <div class="auth-icon" style="background: linear-gradient(135deg, #22c55e, #15803d);"><i class="bi bi-check-circle-fill"></i></div>
    <h4 class="mb-1">Password Reset Successful</h4>
    <p class="text-muted-light small">You can now sign in with your new password.</p>
    <a asp-controller="Account" asp-action="Login" class="btn btn-auth-primary w-100 mt-2">Sign In</a>
</div>
