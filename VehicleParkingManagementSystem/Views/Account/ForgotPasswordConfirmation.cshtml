@{
    ViewData["Title"] = "Check Your Email";
    Layout = "_AuthLayout";
}

<div class="auth-card text-center">
    <div class="auth-icon" style="background: linear-gradient(135deg, #22c55e, #15803d);"><i class="bi bi-envelope-check-fill"></i></div>
    <h4 class="mb-1">Check Your Email</h4>
    <p class="text-muted-light small">If an account exists with that email address, a password reset link has been generated.</p>

    @if (ViewBag.ResetLink is not null)
    {
        <div class="alert alert-warning text-start small">
            <strong>No email server is configured for this project.</strong>
            Use this link to reset your password:<br />
            <a href="@ViewBag.ResetLink" class="text-break">@ViewBag.ResetLink</a>
        </div>
    }

    <a asp-controller="Account" asp-action="Login" class="btn btn-auth-primary w-100 mt-2">Back to Sign In</a>
</div>
