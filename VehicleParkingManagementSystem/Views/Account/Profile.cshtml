@model VehicleParkingManagementSystem.Models.ApplicationUser
@{
    ViewData["Title"] = "My Profile";
    ViewBag.PageTitle = "My Profile";
    ViewBag.PageSubtitle = "Manage your account photo and details";
}

@if (TempData["StatusMessage"] is not null)
{
    <div class="alert alert-info">@TempData["StatusMessage"]</div>
}

<div class="row g-3">
    <div class="col-md-4">
        <div class="app-card text-center p-4">
            @if (!string.IsNullOrEmpty(Model.ProfilePicturePath))
            {
                <img src="@Model.ProfilePicturePath" alt="Profile picture" class="rounded-circle mb-3" style="width: 140px; height: 140px; object-fit: cover;" />
            }
            else
            {
                <div class="avatar-circle mx-auto mb-3" style="width: 140px; height: 140px; font-size: 3rem;">
                    @Model.FullName.Substring(0, 1).ToUpper()
                </div>
            }

            <h5 class="mb-0">@Model.FullName</h5>
            <p class="text-muted small">@Model.Email</p>

            <form asp-controller="Account" asp-action="UploadProfilePicture" method="post" enctype="multipart/form-data" class="mt-3">
                <div class="mb-2">
                    <input type="file" name="file" class="form-control form-control-sm" accept="image/jpeg,image/png,image/webp" required />
                </div>
                <button type="submit" class="btn btn-primary btn-sm w-100"><i class="bi bi-upload"></i> Upload Photo</button>
            </form>

            @if (!string.IsNullOrEmpty(Model.ProfilePicturePath))
            {
                <form asp-controller="Account" asp-action="DeleteProfilePicture" method="post" class="mt-2">
                    <button type="submit" class="btn btn-outline-danger btn-sm w-100"><i class="bi bi-trash"></i> Remove Photo</button>
                </form>
            }

            <p class="text-muted mt-2 mb-0" style="font-size: 0.75rem;">JPG, PNG or WEBP. Max 3 MB.</p>
        </div>
    </div>

    <div class="col-md-8">
        <div class="app-card p-4">
            <h6 class="mb-3">Account Details</h6>
            <dl class="row mb-0">
                <dt class="col-sm-4">Full Name</dt>
                <dd class="col-sm-8">@Model.FullName</dd>

                <dt class="col-sm-4">Email</dt>
                <dd class="col-sm-8">@Model.Email</dd>

                <dt class="col-sm-4">Phone Number</dt>
                <dd class="col-sm-8">@(Model.PhoneNumber ?? "-")</dd>

                <dt class="col-sm-4">Member Since</dt>
                <dd class="col-sm-8">@Model.CreatedAt.ToLocalTime().ToString("d MMM yyyy")</dd>
            </dl>
            <a asp-controller="Account" asp-action="ChangePassword" class="btn btn-outline-secondary btn-sm mt-3">
                <i class="bi bi-key"></i> Change Password
            </a>
        </div>
    </div>
</div>
