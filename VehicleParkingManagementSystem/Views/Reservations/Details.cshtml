@model VehicleParkingManagementSystem.Models.Reservation
@{
    ViewData["Title"] = "Reservation Details";
}

<h3 class="mb-3">Reservation Details</h3>

@if (TempData["StatusMessage"] is not null)
{
    <div class="alert alert-info">@TempData["StatusMessage"]</div>
}

<div class="app-card mb-3" style="max-width: 600px;">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-4">Vehicle</dt>
            <dd class="col-sm-8">@Model.Vehicle?.VehicleNumber</dd>

            <dt class="col-sm-4">Area</dt>
            <dd class="col-sm-8">@(Model.ParkingArea?.Name ?? "-")</dd>

            <dt class="col-sm-4">From</dt>
            <dd class="col-sm-8">@Model.ReservedFrom.ToLocalTime().ToString("d MMM yyyy, HH:mm")</dd>

            <dt class="col-sm-4">To</dt>
            <dd class="col-sm-8">@Model.ReservedTo.ToLocalTime().ToString("d MMM yyyy, HH:mm")</dd>

            <dt class="col-sm-4">Status</dt>
            <dd class="col-sm-8">@Model.Status</dd>

            @if (Model.Status == VehicleParkingManagementSystem.Models.ReservationStatus.Cancelled)
            {
                <dt class="col-sm-4">Cancelled</dt>
                <dd class="col-sm-8">@Model.CancelledAt?.ToLocalTime().ToString("d MMM yyyy, HH:mm") - @Model.CancellationReason</dd>
            }
        </dl>
    </div>
    @if (Model.Status is VehicleParkingManagementSystem.Models.ReservationStatus.Pending or VehicleParkingManagementSystem.Models.ReservationStatus.Confirmed)
    {
        <div class="card-footer">
            <form asp-action="Cancel" asp-route-id="@Model.Id" method="post" class="d-flex gap-2">
                <input type="text" name="reason" class="form-control form-control-sm" placeholder="Cancellation reason (optional)" />
                <button type="submit" class="btn btn-sm btn-outline-danger text-nowrap">Cancel Reservation</button>
            </form>
        </div>
    }
</div>

<a asp-action="Index" class="btn btn-outline-secondary mt-3">Back to Reservations</a>
