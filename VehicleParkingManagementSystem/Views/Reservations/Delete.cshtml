@model VehicleParkingManagementSystem.Models.Reservation
@{
    ViewData["Title"] = "Delete Reservation";
}

<h3 class="mb-3">Delete Reservation</h3>

<div class="app-card border-danger" style="max-width: 600px;">
    <div class="card-body">
        <p>Are you sure you want to delete the following reservation?</p>
        <dl class="row mb-0">
            <dt class="col-sm-4">Vehicle</dt>
            <dd class="col-sm-8">@(Model.Vehicle?.VehicleNumber ?? "-")</dd>

            <dt class="col-sm-4">Area</dt>
            <dd class="col-sm-8">@(Model.ParkingArea?.Name ?? "-")</dd>

            <dt class="col-sm-4">From</dt>
            <dd class="col-sm-8">@Model.ReservedFrom.ToLocalTime().ToString("d MMM yyyy, HH:mm")</dd>

            <dt class="col-sm-4">To</dt>
            <dd class="col-sm-8">@Model.ReservedTo.ToLocalTime().ToString("d MMM yyyy, HH:mm")</dd>

            <dt class="col-sm-4">Status</dt>
            <dd class="col-sm-8">@Model.Status</dd>
        </dl>
    </div>
    <div class="card-footer">
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
            <button type="submit" class="btn btn-danger btn-sm">Delete</button>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Cancel</a>
        </form>
    </div>
</div>
