@model VehicleParkingManagementSystem.Models.ViewModels.PagedResult<VehicleParkingManagementSystem.Models.Reservation>
@{
    ViewData["Title"] = "Reservations";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Reservations</h3>
    <div class="d-flex gap-2">
        <a asp-action="ExportExcel" asp-route-search="@ViewBag.Search" class="btn btn-outline-success"><i class="bi bi-file-earmark-excel"></i> Export to Excel</a>
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> New Reservation</a>
    </div>
</div>

@if (TempData["StatusMessage"] is not null)
{
    <div class="alert alert-info">@TempData["StatusMessage"]</div>
}

<form method="get" class="row g-2 mb-3">
    <div class="col-auto flex-grow-1">
        <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Search by vehicle number..." />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary"><i class="bi bi-search"></i> Search</button>
    </div>
</form>

<div class="app-card">
    <div class="table-responsive">
        <table class="table table-modern table-hover mb-0 align-middle">
            <thead>
                <tr>
                    <th>Vehicle</th>
                    <th>Area</th>
                    <th>From</th>
                    <th>To</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var reservation in Model.Items)
                {
                    var badgeClass = reservation.Status switch
                    {
                        VehicleParkingManagementSystem.Models.ReservationStatus.Confirmed => "reserved",
                        VehicleParkingManagementSystem.Models.ReservationStatus.Pending => "pending",
                        VehicleParkingManagementSystem.Models.ReservationStatus.Cancelled => "cancelled",
                        VehicleParkingManagementSystem.Models.ReservationStatus.Completed => "completed",
                        _ => "danger"
                    };
                    <tr>
                        <td class="fw-semibold">@reservation.Vehicle?.VehicleNumber</td>
                        <td>@(reservation.ParkingArea?.Name ?? "-")</td>
                        <td>@reservation.ReservedFrom.ToLocalTime().ToString("d MMM, HH:mm")</td>
                        <td>@reservation.ReservedTo.ToLocalTime().ToString("d MMM, HH:mm")</td>
                        <td><span class="status-pill @badgeClass">@reservation.Status</span></td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@reservation.Id" class="btn btn-sm btn-outline-secondary"><i class="bi bi-eye"></i></a>
                            @if (User.IsInRole(AppRoles.Admin) || User.IsInRole(AppRoles.ParkingOfficer))
                            {
                                <a asp-action="Delete" asp-route-id="@reservation.Id" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></a>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Items.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">No reservations found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination justify-content-center">
            @for (var i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-search="@ViewBag.Search">@i</a>
                </li>
            }
        </ul>
    </nav>
}
