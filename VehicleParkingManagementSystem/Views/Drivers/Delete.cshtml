@model VehicleParkingManagementSystem.Models.Driver
@{
    ViewData["Title"] = "Delete Driver";
}

<h3 class="mb-3">Delete Driver</h3>

<div class="app-card border-danger" style="max-width: 600px;">
    <div class="card-body">
        <p>Are you sure you want to delete the following driver?</p>
        <dl class="row mb-0">
            <dt class="col-sm-4">Name</dt>
            <dd class="col-sm-8">@Model.FullName</dd>

            <dt class="col-sm-4">Phone</dt>
            <dd class="col-sm-8">@Model.PhoneNumber</dd>
        </dl>
        @if (Model.Vehicles.Any())
        {
            <div class="alert alert-warning mt-2 mb-0">This driver has @Model.Vehicles.Count registered vehicle(s) and cannot be deleted until they are removed.</div>
        }
    </div>
    <div class="card-footer">
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
            <button type="submit" class="btn btn-danger btn-sm">Delete</button>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Cancel</a>
        </form>
    </div>
</div>
