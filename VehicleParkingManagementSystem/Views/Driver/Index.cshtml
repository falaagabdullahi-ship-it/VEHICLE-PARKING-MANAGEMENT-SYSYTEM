@model VehicleParkingManagementSystem.Models.ViewModels.Dashboard.DriverDashboardViewModel
@{
    ViewData["Title"] = "Driver Dashboard";
}

<h3 class="mb-3">Welcome, @User.Identity?.Name</h3>

<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="app-card h-100">
            <div class="card-body">
                <div class="text-muted small">My Vehicles</div>
                <div class="fs-3 fw-bold">@Model.VehicleCount</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="app-card h-100">
            <div class="card-body">
                <div class="text-muted small">Upcoming Reservations</div>
                <div class="fs-3 fw-bold">@Model.UpcomingReservationCount</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="app-card h-100">
            <div class="card-body">
                <div class="text-muted small">Total Spent</div>
                <div class="fs-3 fw-bold">@Model.TotalSpent.ToString("C")</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="app-card h-100 @(Model.HasActiveSession ? "border-success" : "")">
            <div class="card-body">
                <div class="text-muted small">Currently Parked</div>
                <div class="fs-5 fw-bold">@(Model.HasActiveSession ? "Yes" : "No")</div>
            </div>
        </div>
    </div>
</div>

@if (Model.HasActiveSession)
{
    <div class="alert alert-success">
        Your vehicle <strong>@Model.ActiveVehicleNumber</strong> is currently parked
        @(Model.ActiveAreaName is not null ? $"in {Model.ActiveAreaName}" : "") since @Model.ActiveCheckInTime?.ToLocalTime().ToString("d MMM, HH:mm").
    </div>
}

<div class="row g-3">
    <div class="col-md-4">
        <a asp-controller="Reservations" asp-action="Create" class="btn btn-primary w-100 py-3">
            <i class="bi bi-calendar-plus"></i> Reserve a Slot
        </a>
    </div>
    <div class="col-md-4">
        <a asp-controller="Reservations" asp-action="Index" class="btn btn-outline-secondary w-100 py-3">
            <i class="bi bi-calendar-check"></i> My Reservations
        </a>
    </div>
    <div class="col-md-4">
        <a asp-controller="Account" asp-action="ChangePassword" class="btn btn-outline-secondary w-100 py-3">
            <i class="bi bi-gear"></i> Account Settings
        </a>
    </div>
</div>
