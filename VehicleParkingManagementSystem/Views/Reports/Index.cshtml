@{
    ViewData["Title"] = "Reports";
}

<h3 class="mb-3">Reports</h3>

<div class="row g-3">
    <div class="col-md-3">
        <div class="app-card h-100">
            <div class="card-body text-center">
                <i class="bi bi-calendar-week text-primary" style="font-size: 2rem;"></i>
                <h6 class="mt-2">Parking Activity</h6>
                <p class="text-muted small">Daily / weekly / monthly check-in &amp; check-out usage</p>
                <a asp-action="ParkingActivity" class="btn btn-sm btn-outline-primary">Open</a>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="app-card h-100">
            <div class="card-body text-center">
                <i class="bi bi-calendar-check text-warning" style="font-size: 2rem;"></i>
                <h6 class="mt-2">Reservations</h6>
                <p class="text-muted small">Reservation history and status breakdown</p>
                <a asp-action="Reservations" class="btn btn-sm btn-outline-warning">Open</a>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="app-card h-100">
            <div class="card-body text-center">
                <i class="bi bi-car-front text-secondary" style="font-size: 2rem;"></i>
                <h6 class="mt-2">Vehicles</h6>
                <p class="text-muted small">Registered vehicles, optionally by driver</p>
                <a asp-action="Vehicles" class="btn btn-sm btn-outline-secondary">Open</a>
            </div>
        </div>
    </div>
</div>
