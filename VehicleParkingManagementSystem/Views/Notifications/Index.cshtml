@model List<VehicleParkingManagementSystem.Models.Notification>
@{
    ViewData["Title"] = "Notifications";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Notifications</h3>
    <div class="d-flex gap-2">
        <a asp-action="ExportExcel" class="btn btn-outline-success btn-sm"><i class="bi bi-file-earmark-excel"></i> Export to Excel</a>
        <form asp-action="MarkAllRead" method="post">
            <button type="submit" class="btn btn-outline-secondary btn-sm">Mark all as read</button>
        </form>
    </div>
</div>

<div class="app-card">
    <ul class="list-group list-group-flush">
        @foreach (var n in Model)
        {
            var typeBadge = n.Type switch
            {
                VehicleParkingManagementSystem.Models.NotificationType.ParkingFull => "bg-danger",
                VehicleParkingManagementSystem.Models.NotificationType.ReservationReminder => "bg-warning text-dark",
                VehicleParkingManagementSystem.Models.NotificationType.CheckoutReminder => "bg-info text-dark",
                _ => "bg-secondary"
            };
            <li class="list-group-item @(n.IsRead ? "" : "bg-light")">
                <div class="d-flex justify-content-between">
                    <div>
                        <span class="badge @typeBadge">@n.Type</span>
                        <strong class="ms-2">@n.Title</strong>
                        <div class="small text-muted mt-1">@n.Message.Split('[')[0]</div>
                    </div>
                    <div class="text-end">
                        <div class="small text-muted">@n.CreatedAt.ToLocalTime().ToString("d MMM yyyy, HH:mm")</div>
                        @if (!n.IsRead)
                        {
                            <form asp-action="MarkRead" asp-route-id="@n.Id" method="post" class="mt-1">
                                <button type="submit" class="btn btn-sm btn-link p-0">Mark as read</button>
                            </form>
                        }
                    </div>
                </div>
            </li>
        }
        @if (!Model.Any())
        {
            <li class="list-group-item text-center text-muted py-4">No notifications yet.</li>
        }
    </ul>
</div>
