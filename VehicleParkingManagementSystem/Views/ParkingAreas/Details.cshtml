@model VehicleParkingManagementSystem.Models.ParkingArea
@{
    ViewData["Title"] = Model.Name;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h3 class="mb-0">@Model.Name @if (Model.IsVip) { <span class="badge bg-warning text-dark">VIP</span> }</h3>
        <p class="text-muted mb-0">@(Model.Location ?? "No location set")</p>
    </div>
</div>

@if (TempData["StatusMessage"] is not null)
{
    <div class="alert alert-success">@TempData["StatusMessage"]</div>
}

<div class="app-card" style="max-width: 600px;">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-4">Name</dt>
            <dd class="col-sm-8">@Model.Name</dd>

            <dt class="col-sm-4">Location</dt>
            <dd class="col-sm-8">@(Model.Location ?? "-")</dd>

            <dt class="col-sm-4">Description</dt>
            <dd class="col-sm-8">@(Model.Description ?? "-")</dd>

            <dt class="col-sm-4">VIP Area</dt>
            <dd class="col-sm-8">@(Model.IsVip ? "Yes" : "No")</dd>

            <dt class="col-sm-4">Created</dt>
            <dd class="col-sm-8">@Model.CreatedAt.ToLocalTime().ToString("d MMM yyyy")</dd>
        </dl>
    </div>
</div>

<a asp-action="Index" class="btn btn-outline-secondary mt-3">Back to Areas</a>
